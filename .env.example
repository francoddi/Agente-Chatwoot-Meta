# URL base de Chatwoot, SIN barra final. Ej: https://app.chatwoot.com
CHATWOOT_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Etiqueta que, puesta en una conversación, pausa al bot (atención humana).
PAUSE_LABEL=bot_off

# Etiqueta que el bot se pone solo cuando deriva al cliente a Camila (detecta que el mensaje
# que manda contiene el link de NUMERO_CAMILA).
DERIVADO_LABEL=ddd

# Registro automático en Google Sheets (opcional): cada derivación a Camila agrega una fila
# con nombre, email, plan, dirección, etc. (columnas fijas, ver log_to_google_sheets en
# main.py). Vacío = deshabilitado. GOOGLE_SHEETS_CREDENTIALS_JSON es el contenido completo del
# .json de una cuenta de servicio de Google Cloud (con la API de Sheets habilitada), pegado en
# una sola línea; esa cuenta de servicio necesita permiso de Editor en la planilla (se comparte
# por su "client_email", como a cualquier persona).
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Hoja 1

# Nº de mensajes previos que se pasan al LLM como memoria de la conversación.
MAX_HISTORIAL=20

# Link de WhatsApp de Camila (a donde el cliente toca para escribirle y reenviarle sus datos).
# Formato: https://wa.me/<codigo_pais><9 si es celular arg><codigo_area><numero>, todo junto sin
# espacios ni signos. Ej. para +54 9 223 694-6909: https://wa.me/5492236946909
# Este mismo número se usa también para avisarle a Camila por WhatsApp (mensaje normal, como a
# cualquier contacto) cada vez que se carga una fila nueva en Sheets. Para que le lleguen esos
# avisos, Camila tiene que haberle escrito ella primero al número del negocio (regla de Meta:
# activa la ventana de 24hs) y esa conversación con ella debe tener la etiqueta PAUSE_LABEL
# puesta, para que Valentina nunca le responda a ella como si fuera un cliente.
NUMERO_CAMILA=

# Resumen diario (opcional): a esta hora (huso Argentina) se le manda al dueño un WhatsApp con
# los leads recibidos, delegados y el % de conversión del día (excluye a Camila y al dueño del
# conteo de leads). Vacío NUMERO_DUENO = deshabilitado. Mismo requisito de WhatsApp que con
# Camila: ese número tiene que haberle escrito antes al número del negocio.
NUMERO_DUENO=
RESUMEN_DIARIO_HORA=00:00

# Agrupamiento de mensajes: segundos que se espera ANTES de empezar a generar la respuesta.
# En 0 (recomendado), arranca a generar al toque; si llega un mensaje nuevo mientras está
# generando, esa generación se cancela y arranca de nuevo con todo lo que haya hasta ese
# momento (el propio tiempo de generación actúa como ventana de agrupamiento).
MSG_DEBOUNCE_SECONDS=0

# Seguimiento automático: si el cliente no responde, le manda UN mensaje de seguimiento con
# contexto (ver NOTA TÉCNICA en el SYSTEM_PROMPT). La espera se elige al azar entre estos dos
# valores (en segundos) cada vez que se programa. 2700-3600 = entre 45 y 60 minutos.
FOLLOWUP_DELAY_MIN_SECONDS=2700
FOLLOWUP_DELAY_MAX_SECONDS=3600

PORT=8000

# IMPORTANTE: no incluyas aquí variables de Meta (token de WhatsApp, Phone Number ID, etc.).
# Esas se configuran en el inbox de WhatsApp Cloud dentro de Chatwoot, no en este bot.
