# URL base de Chatwoot, SIN barra final. Ej: https://app.chatwoot.com
CHATWOOT_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Etiqueta que, puesta en una conversación, pausa al bot (atención humana).
PAUSE_LABEL=bot_off

# Nº de mensajes previos que se pasan al LLM como memoria de la conversación.
MAX_HISTORIAL=20

# Link de WhatsApp de Camila (a donde el cliente toca para escribirle y reenviarle sus datos).
# Formato: https://wa.me/<codigo_pais><9 si es celular arg><codigo_area><numero>, todo junto sin
# espacios ni signos. Ej. para +54 9 223 694-6909: https://wa.me/5492236946909
NUMERO_CAMILA=

# Agrupamiento de mensajes: segundos que se espera tras el último mensaje del cliente antes
# de responder (por si sigue escribiendo), y tope máximo de espera desde el primer mensaje
# de la tanda aunque el cliente no pare de escribir.
MSG_DEBOUNCE_SECONDS=10
MSG_DEBOUNCE_MAX_WAIT=30

PORT=8000

# IMPORTANTE: no incluyas aquí variables de Meta (token de WhatsApp, Phone Number ID, etc.).
# Esas se configuran en el inbox de WhatsApp Cloud dentro de Chatwoot, no en este bot.
